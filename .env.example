# Existing Schwab connection. Set in Railway; never commit real values.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=

# Dedicated lotto channel webhook.
DISCORD_LOTTO_WEBHOOK=
# Start in shadow mode, then set true to publish qualifying potential alerts.
LOTTO_SEND_ALERTS=false
DATA_DIR=/app/data
LOG_LEVEL=INFO

LOTTO_UNIVERSE=NVDA,AMD,ARM,INTC,TSLA,META,AMZN,MSFT,GOOGL,AVGO,MU,SMCI,HOOD,COIN,MSTR,MRNA
LOTTO_POLL_SECONDS=60
LOTTO_MAX_ALERTS_PER_DAY=5
LOTTO_MAX_ALERTS_PER_TICKER=2
LOTTO_MAX_ALERTS_PER_CYCLE=1
LOTTO_TICKER_COOLDOWN_MINUTES=45
LOTTO_CONFIRMATION_MINUTES=3
LOTTO_MIN_SCORE=72
LOTTO_MIN_PACE_RVOL=2.0
LOTTO_MIN_OPTION_ACCELERATION=1.5
LOTTO_MIN_CLUSTER=3
LOTTO_MIN_STRIKE_VOLUME_5M=100
LOTTO_MIN_ASK=0.15
LOTTO_MAX_ASK=2.50
LOTTO_MAX_SPREAD_FRACTION=0.15
LOTTO_MAX_SPREAD_DOLLARS=0.15
LOTTO_MIN_DELTA=0.12
LOTTO_MAX_DELTA=0.55
LOTTO_MAX_DTE=7
LOTTO_ENTRY_CUTOFF_MINUTES=30
