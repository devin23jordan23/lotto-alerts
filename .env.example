# Existing Schwab connection. Set in Railway; never commit real values.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=
SCHWAB_TOKEN_BROKER_URL=
SCHWAB_TOKEN_BROKER_KEY=

# Dedicated lotto channel webhook.
DISCORD_LOTTO_WEBHOOK=
# Start in shadow mode, then set true to publish qualifying potential alerts.
LOTTO_SEND_ALERTS=false
DATA_DIR=/app/data
LOG_LEVEL=INFO

# Keep this synchronized with UOA_CORE_UNIVERSE in the existing unusual-options scanner.
LOTTO_UNIVERSE=SPY,QQQ,IWM,DIA,SMH,SOXX,XLK,XLF,XLE,GLD,USO,SLV,MTUM,AAPL,MSFT,NVDA,TSLA,META,AMZN,GOOGL,NFLX,AVGO,AMD,PLTR,COIN,HOOD,MSTR,MU,TSM,ARM,QCOM,MRVL,INTC,AMAT,LRCX,KLAC,ASML,SNDK,SMCI,DELL,VRT,ANET,NBIS,AAOI,CSCO,HPE,NOW,ORCL,CRM,ADBE,SNOW,DDOG,NET,CRWD,PANW,ZS,OKTA,TEAM,MDB,SHOP,BE,VST,CEG,NRG,OKLO,FSLR,ENPH,PYPL,SOFI,AFRM,UPST,RBLX,UBER,ABNB,JPM,BAC,MS,GS,C,SCHW,V,MA,AXP,WMT,TGT,COST,MCD,CMG,LULU,NKE,SBUX,HD,LOW,LLY,UNH,MRNA,REGN,ISRG,BA,LMT,CAT,DE,XOM,CVX
LOTTO_POLL_SECONDS=60
LOTTO_CHAIN_CAPACITY=60
LOTTO_API_MIN_INTERVAL_SECONDS=0.25
LOTTO_ACTIVE_QUALITY_GATE=1
LOTTO_CONTINUOUS_SYMBOLS=SPY,QQQ,IWM,META,NVDA,AMD,TSLA,AAPL,MSFT,AMZN,GOOGL,AVGO,MU,MRNA,SMCI,COIN,PLTR,NFLX
LOTTO_SWEEP_PER_CYCLE=26
LOTTO_SWEEP_MINUTES=3
LOTTO_MAX_ALERTS_PER_DAY=0
LOTTO_MAX_ALERTS_PER_TICKER=0
LOTTO_MAX_ALERTS_PER_CYCLE=0
LOTTO_CONFIRMATION_MINUTES=1
LOTTO_MIN_OPENING_BARS=3
# Model V is the live default (LOTTO_MODEL unset). Its floor is clamped at 60
# even if this is set higher. LOTTO_MODEL=S with LOTTO_MIN_SCORE=70 restores
# the previous option floor. Stock-only cards stay internal in both models.
LOTTO_MODEL=V
LOTTO_MIN_SCORE=60
LOTTO_SEND_REQUOTE=1
# s12 is the live score. Hybrid lane: v2 >= 40 (0DTE) or >= 61 (1DTE).
# Handoff lane: fitted win chance. LOTTO_PRESET=S11 uses the tighter floors.
# LOTTO_SCORE_MODE=combined is the rollback (one score, bars 40/61, stock cap,
# plus the rare stock_override path). LOTTO_PRESET=S0 turns the handoff floors off.
LOTTO_SCORE_MODE=s12
LOTTO_POST_COMBINED_0DTE=40
LOTTO_POST_COMBINED_1DTE=61
LOTTO_STOCK_MAX_SHARE=0.40
LOTTO_POST_V2_OPTION_0DTE=40
LOTTO_POST_V2_OPTION_1DTE=61
LOTTO_POST_V2_STOCK_0DTE=58
LOTTO_POST_V2_STOCK_1DTE=80
# Handoff floors come from this preset. S11 is the tighter set. Leftover
# LOTTO_PWIN_* variables are ignored, and startup warns when they differ.
LOTTO_PRESET=S12
LOTTO_STRENGTH_QUINTILE=0.8016471997604073
LOTTO_STRENGTH_DECILE=0.8756064690026955
# prior_atr for scores, posts, and handoff triggers. 21 is the mean of the
# prior daily true ranges (today excluded, at least 15). Fewer than 15 ranges
# leaves prior_atr empty; the 14-day average is not substituted. 14 restores it.
LOTTO_ATR_DAYS=21
# Go-live: true is required. false logs "Handoff fallback state: shadow" and
# stock-led option cards do not post. LOTTO_STOCK_FIRST_MODE is not read by
# that lane. Leave it at shadow. Do not set send to turn option cards on.
# Stock-only cards never post in any mode.
LOTTO_STOCK_FIRST_ENABLED=true
LOTTO_STOCK_FIRST_MODE=shadow
# Strong-stock fallback. Default log: one JSONL line per would-be card under
# DATA_DIR/fallback-rule.jsonl, nothing posted, handoff floors unchanged.
# on posts the priced option card and uses the normal A-bar pF floors.
# off skips the rule. Thresholds stay here so a re-test can move them.
# The +5 minute same-move window is for nightly grading only. It does not
# hold the log line and it never suppresses an option-side card.
LOTTO_FALLBACK_RULE=log
LOTTO_FB_RVOL_MIN=0.78
LOTTO_FB_PUSH_ATR_MIN=0.5
LOTTO_FB_MAX_SPREAD_PCT=30
LOTTO_FB_SAME_MOVE_BEFORE_MIN=15
LOTTO_FB_SAME_MOVE_AFTER_MIN=5
# Both default to config/handoff_model_v1026.json. Set either empty to disable.
# LOTTO_HANDOFF_MODEL_PATH=
# LOTTO_STRENGTH_DISTRIBUTION_PATH=
# Exceptional stock override. All of these must hit. Defaults are intentionally high.
LOTTO_OVERRIDE_MOVE_ATR=2.5
LOTTO_OVERRIDE_RVOL=3.0
LOTTO_OVERRIDE_VWAP_SHARE=0.80
LOTTO_OVERRIDE_FRESH_SECONDS=30
LOTTO_OVERRIDE_TRIGGER_MINUTES=5
# Runner standby names are off. Set on for S12 plus those names at the handoff
# A bar (normal win-chance floors, no strength step-down).
LOTTO_STANDBY_NAMES=off
# Chains for those names run only while the name is in play.
# LOTTO_STANDBY_UNIVERSE=IREN,CRWV,LITE,TTMI,HUT,CORZ,DKNG,RIVN,LUNR,HIMS,MARA,SOXL,GME,EWZ,TLT,RIOT,XLI,TEM,STX,IBIT,U
LOTTO_STANDBY_INCLUDE_UOA=1
LOTTO_STANDBY_GAP=0.015
LOTTO_STANDBY_MOVE=0.01
LOTTO_STANDBY_ATR=0.35
LOTTO_STANDBY_RVOL=1.5
LOTTO_STANDBY_SCAN_MINUTES=3
LOTTO_STANDBY_QUOTE_MINUTES=1
LOTTO_STANDBY_SCANS_PER_CYCLE=4
LOTTO_QUOTE_BATCH=180
LOTTO_MIN_PACE_RVOL=2.0
LOTTO_MIN_LOCAL_RVOL=1.2
LOTTO_MIN_LOCAL_ACCELERATION=1.2
LOTTO_MIN_RANGE_ATR=0.2
LOTTO_MIN_OPTION_ACCELERATION=1.3
LOTTO_MIN_CLUSTER=2
LOTTO_MIN_STRIKE_VOLUME_5M=75
LOTTO_MIN_ASK=0.10
LOTTO_MAX_ASK=2.50
LOTTO_MAX_SCALED_ASK=7.50
LOTTO_PREMIUM_ATR_FRACTION=0.25
LOTTO_MAX_OTM_ATR=1.0
LOTTO_MAX_BUILDING_DISTANCE_ATR=0.06
LOTTO_MAX_ENTRY_EXTENSION_ATR=0.25
LOTTO_MAX_SPREAD_FRACTION=0.15
LOTTO_MAX_SPREAD_DOLLARS=0.15
LOTTO_MIN_DELTA=0.10
LOTTO_MAX_DELTA=0.55
LOTTO_MAX_DTE=1
LOTTO_ENTRY_CUTOFF_MINUTES=15

# Model S. off preserves the prior gate; shadow observes; enforce owns routing.
LOTTO_QUALITY_MODE=off
LOTTO_QUALITY_POLICY=S
LOTTO_QUALITY_SHADOW_EXTRA=stack8
LOTTO_QUALITY_DISABLED_RULES=
# Optional: SECONDARY stays internal and tracked when this is unset.
DISCORD_LOTTO_SECONDARY_WEBHOOK=
