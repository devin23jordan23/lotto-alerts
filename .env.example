# Existing Schwab connection. Set in Railway; never commit real values.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=
SCHWAB_TOKEN_BROKER_URL=
SCHWAB_TOKEN_BROKER_KEY=

# Dedicated lotto channel webhook.
DISCORD_LOTTO_WEBHOOK=
# Start in shadow mode, then set true to publish qualifying potential alerts.
LOTTO_SEND_ALERTS=false
DATA_DIR=/app/data
# Optional. Unset uses $DATA_DIR/live.sqlite3. The file must stay on the volume.
# LOTTO_DB_PATH=/app/data/live.sqlite3
# 1 only for a genuine first start on an empty volume. Do not leave it set.
# LOTTO_ALLOW_EMPTY_LIVE_DB=0
# 1 only after confirming the volume path is durable when it is not a separate device.
# It does not permit a database path outside RAILWAY_VOLUME_MOUNT_PATH.
# LOTTO_TRUST_VOLUME_MOUNT=0
LOG_LEVEL=INFO

# Keep this synchronized with UOA_CORE_UNIVERSE in the existing unusual-options scanner.
LOTTO_UNIVERSE=SPY,QQQ,IWM,DIA,SMH,SOXX,XLK,XLF,XLE,GLD,USO,SLV,MTUM,AAPL,MSFT,NVDA,TSLA,META,AMZN,GOOGL,NFLX,AVGO,AMD,PLTR,COIN,HOOD,MSTR,MU,TSM,ARM,QCOM,MRVL,INTC,AMAT,LRCX,KLAC,ASML,SNDK,SMCI,DELL,VRT,ANET,NBIS,AAOI,CSCO,HPE,NOW,ORCL,CRM,ADBE,SNOW,DDOG,NET,CRWD,PANW,ZS,OKTA,TEAM,MDB,SHOP,BE,VST,CEG,NRG,OKLO,FSLR,ENPH,PYPL,SOFI,AFRM,UPST,RBLX,UBER,ABNB,JPM,BAC,MS,GS,C,SCHW,V,MA,AXP,WMT,TGT,COST,MCD,CMG,LULU,NKE,SBUX,HD,LOW,LLY,UNH,MRNA,REGN,ISRG,BA,LMT,CAT,DE,XOM,CVX
LOTTO_POLL_SECONDS=60
LOTTO_CHAIN_CAPACITY=30
LOTTO_CONTINUOUS_SYMBOLS=SPY,QQQ,IWM,META,NVDA,AMD,TSLA,AAPL,MSFT,AMZN,GOOGL,AVGO,MU,MRNA,SMCI,COIN,PLTR,NFLX
LOTTO_SWEEP_PER_CYCLE=26
LOTTO_SWEEP_MINUTES=3
LOTTO_MAX_ALERTS_PER_DAY=0
LOTTO_MAX_ALERTS_PER_TICKER=0
LOTTO_MAX_ALERTS_PER_CYCLE=0
LOTTO_TICKER_COOLDOWN_MINUTES=30
LOTTO_CONFIRMATION_MINUTES=1
LOTTO_MIN_OPENING_BARS=3
LOTTO_MIN_SCORE=70
LOTTO_MIN_PACE_RVOL=2.0
LOTTO_MIN_LOCAL_RVOL=1.2
LOTTO_MIN_LOCAL_ACCELERATION=1.2
LOTTO_MIN_RANGE_ATR=0.2
LOTTO_MIN_OPTION_ACCELERATION=1.3
LOTTO_MIN_CLUSTER=2
LOTTO_MIN_STRIKE_VOLUME_5M=75
LOTTO_MIN_ASK=0.10
LOTTO_MAX_ASK=2.50
LOTTO_MAX_SCALED_ASK=7.50
LOTTO_PREMIUM_ATR_FRACTION=0.25
LOTTO_MAX_OTM_ATR=1.0
LOTTO_MAX_BUILDING_DISTANCE_ATR=0.06
LOTTO_MAX_ENTRY_EXTENSION_ATR=0.25
LOTTO_MAX_SPREAD_FRACTION=0.15
LOTTO_MAX_SPREAD_DOLLARS=0.15
LOTTO_MIN_DELTA=0.10
LOTTO_MAX_DELTA=0.55
LOTTO_MAX_DTE=1
LOTTO_ENTRY_CUTOFF_MINUTES=15

# Research gates. 0 off, 1 log only, 2 block. Leave both at 1.
# Mode 2 is not authorized by the Nov 9 check: the far-OTM cutoff was chosen on
# the same sample it is scored on, and the high-low ATR basis was not a better
# Friday (the attached recount was about 4/41). Live DZ/BF blocking stays the
# existing LOTTO_DEAD_ZONE_MODE / LOTTO_BURST_FLAT_MODE environment. Do not set
# LOTTO_SPENT_MODE=2.
LOTTO_FAR_OTM_TIME_MODE=1
LOTTO_FAR_OTM_TIME_MAX_ATR=0.8
LOTTO_DM_ATR_BASIS_MODE=1

# Opt-in read-only session export. 0 leaves alerts and posting unchanged.
# Int flags: the settings loader casts with type(default)(raw).
LOTTO_DAY_EXPORT=0
LOTTO_DAY_EXPORT_HOUR=16
LOTTO_DAY_EXPORT_MINUTE=20
LOTTO_DAY_EXPORT_BACKFILL_DAYS=5
# 0 = Google Drive. 1 = S3. Integer: the loader casts with type(default)(raw).
LOTTO_DAY_EXPORT_TARGET=0
# Entire service-account JSON. Railway secret; never commit or log it.
# GDRIVE_SA_JSON=
# GDRIVE_FOLDER_ID=
# S3 target, for a Railway bucket service named lotto-day-export.
# These five are Railway-provided bucket variables (storage buckets docs):
# LOTTO_S3_ENDPOINT=${{lotto-day-export.ENDPOINT}}
# LOTTO_S3_BUCKET=${{lotto-day-export.BUCKET}}
# LOTTO_S3_ACCESS_KEY_ID=${{lotto-day-export.ACCESS_KEY_ID}}
# LOTTO_S3_SECRET_ACCESS_KEY=${{lotto-day-export.SECRET_ACCESS_KEY}}
# LOTTO_S3_REGION=${{lotto-day-export.REGION}}
# Object key prefix. Not a Railway bucket variable.
# LOTTO_S3_PREFIX=day-export/
# virtual (current buckets) or path (buckets created before virtual-hosted URLs).
# The credentials tab shows AWS_S3_URL_STYLE. It is not a reference variable.
# LOTTO_S3_URL_STYLE=virtual
